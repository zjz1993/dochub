# 需要的环境变量清单。复制一份成同目录的 .env 再填写；.env 里是本机的真实口令，不提交到仓库。
#
# 谁在读这些变量：
#   - deploy/compose.dev.yml：命令里用 --env-file .env 指过来，例如
#       docker compose --env-file .env -f deploy/compose.dev.yml up -d
#   - 后端（dev 环境）：启动时需要其中的数据库口令，任务 2.2 接入

# Compose 的项目名，决定容器和数据卷的名字前缀（dochub-mysql-1、dochub_mysql-data）
COMPOSE_PROJECT_NAME=dochub

# ---------- MySQL 8.4 ----------
# 映射到宿主机的端口，后端连 127.0.0.1:<这个端口>
DOCHUB_MYSQL_PORT=3306
# 管理员口令：只在用 IDE 连库、看表时用，应用不用它
DOCHUB_MYSQL_ROOT_PASSWORD=change-me
# 应用账号 dochub 的口令。库名和账号名固定是 dochub，写在 compose 文件里
DOCHUB_MYSQL_PASSWORD=change-me
# 注意：两个口令只在数据卷第一次初始化时生效。之后改这里，库里的口令不会跟着变；
# 想重置就先执行 down -v 再 up（会清空数据）。

# ---------- Redis 7 ----------
# 宿主机的 6379 已被 brew 装的本地 Redis 占用，所以用 6380
DOCHUB_REDIS_PORT=6380

# ---------- 前端（可选）----------
# 开发环境里 Next.js 把 /api 和 /files 转发到这个地址，不设就是 http://localhost:8080。
# Next.js 只读 frontend/ 目录下的 .env，不读这份；要改就在启动 pnpm dev 的终端里 export
# BACKEND_ORIGIN=http://localhost:8080
