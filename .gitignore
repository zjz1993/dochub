# ===== 密钥与本地环境（.env 里有真实口令，绝不进仓库）=====
.env
.env.local
.env.*.local

# ===== IDE =====
.idea/
*.iml
.vscode/

# ===== macOS =====
.DS_Store

# ===== 前端 =====
# frontend/ 里 create-next-app 自带的 .gitignore 已覆盖这些；
# 根目录再兜一层，防止将来目录结构调整后漏掉
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ===== 后端构建产物 =====
